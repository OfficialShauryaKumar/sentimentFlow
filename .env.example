REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
NEWS_API_KEY=paste_your_newsapi_key_here
PORTFOLIO_SIZE=10000
CACHE_TTL_MINUTES=0
FLASK_PORT=5000
RISK_PER_TRADE_PCT=2.0
MAX_POSITION_PCT=10.0
STOP_LOSS_ATR_MULT=2.0
TAKE_PROFIT_RR=2.5
# Set to true if Yahoo has rate-limited your IP (yfinance returns 429s).
# When true, technical indicators and fundamentals are skipped; signals
# are computed from sentiment alone via percentile ranking.
SKIP_YFINANCE=false

# Google Sheets sync — paste the Sheet ID from your sheet's URL.
# A sheet URL looks like:
#   https://docs.google.com/spreadsheets/d/THIS_LONG_STRING_IS_THE_ID/edit
# Leave blank to disable Sheets sync (CSV archive still works).
GOOGLE_SHEET_ID=
GOOGLE_CREDS_PATH=credentials/google_service_account.json
